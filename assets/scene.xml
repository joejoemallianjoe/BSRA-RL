<mujoco model="bsra_cartpole">
  <default>
    <geom contype="0" conaffinity="0"/>
  </default>
  
  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.02"/>
  <compiler angle="degree"/>

  <include file="cartpole.xml"/>
  
  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.1"/>
    <geom name="rail" type="box" pos="0 0 0.06" size="1.5 0.1 0.06"/>
    <light name="light" pos="0 0 3" dir="0 0 -1"/>
    <camera name="side" pos="0 2 1" xyaxes="-1 0 0 0 0 1"/>
  </worldbody>
</mujoco>
