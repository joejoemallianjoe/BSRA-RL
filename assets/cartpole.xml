<mujocoinclude>
  <worldbody>
    <body name="cart" pos="0 0 0.2">
      <geom name="cart_geom" type="box" size="0.15 0.1 0.08" mass="10"/>
      <joint name="slider" type="slide" axis="1 0 0" limited="true" range="-1.25 1.25" damping="1"/>

      <body name="pole" pos="0 0 0.08">
        <joint name="hinge" type="hinge" axis="0 1 0" limited="true" range="-90 90" damping="1"/>
        <geom name="pole_geom" type="capsule" size="0.04" fromto="0 0 0 0 0 0.75" mass="10"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- MEMBER TODO 2.2: Add cart_motor on slider. Set the control limit
         and gear explicitly. The pole has no actuator. -->
  </actuator>
</mujocoinclude>
